#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT    0
#define FUNCTION   1
#define CONNECTION 2

&left_encoder { status = "okay"; };
&right_encoder { status = "okay"; };


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mo 1         &kp F20      &kp C_PP      &kp C_MUTE
                &kp DOT       &kp KP_N1       &kp KP_N4        &kp KP_N7
                &kp KP_N0       &kp KP_N2       &kp KP_N5        &kp KP_N8
                &kp KP_ENTER     &kp KP_N3       &kp KP_N6        &kp KP_N9
            >;
            
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_UP C_VOL_DN>;

        };

        fucntion_layer {
            bindings = <
                &trans                &kp F21             &kp F24        &to 2
                &kp LG(LS(LEFT))      &kp F22             &kp DEL        &kp INS
                &kp LG(LS(DOWN))      &kp LG(LS(UP))      &kp END        &kp HOME
                &kp LG(LS(RIGHT))     &kp F23             &kp PG_DN      &kp PG_UP
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;

        };

        connection_layer {
            bindings = <
                &none           &none         &studio_unlock      &to 0
                &none           &none         &none               &bt BT_SEL 0
                &none           &none         &none               &bt BT_SEL 1
                &bootloader     &none         &bt BT_CLR_ALL      &bt BT_SEL 2
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;

        };


    };
};