#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT    0
#define FUNCTION   1
#define CONNECTION 2

&left_encoder { status = "okay"; };
&right_encoder { status = "okay"; };


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mo 1         &kp F21      &kp C_PP      &kp C_MUTE
                &kp DOT       &kp N1       &kp N4        &kp N7
                &&kp N0       &kp N2       &kp N5        &kp N8
                &kp ENTER     &kp N3       &kp N6        &kp N9
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;

        };

        fucntion_layer {
            bindings = <
                &trans                &kp F22             &kp C_PP       &to 2
                &kp LG(LS(LEFT))      &kp F23             &kp DEL        &kp INS
                &kp LG(LS(DOWN))      &kp LG(LS(UP))      &kp END        &kp HOME
                &kp LG(LS(RIGHT))     &kp F24             &kp PG_DN      &kp PG_UP
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;

        };

        connection_layer {
            bindings = <
                &none           &none         &none               &to 0
                &none           &none         &none               &bt BT_SEL 0
                &none           &none         &none               &bt BT_SEL 1
                &bootloader     &none         &bt BT_CLR_ALL      &bt BT_SEL 2
            >;
            
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;

        };


    };
};